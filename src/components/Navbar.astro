---
const { pathname } = Astro.url
const p = pathname.replace(/\/$/, '') || '/'
const isHome = p === '/'
const isPubs = p === '/publications'
---

<nav class="site-nav">
  <a href="/" class={`nav-link${isHome ? ' active' : ''}`}>Home</a>
  <a href="/publications" class={`nav-link${isPubs ? ' active' : ''}`}
    >Academic publications</a
  >
</nav>
